<!DOCTYPE html>
<html lang="en" class="h-full bg-stone-50">
  <head>
    <title><%= content_for(:title) || "SAEROM" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-stone-50 text-slate-800 antialiased">
    <% if logged_in? %>
      <div class="min-h-screen bg-stone-50" data-controller="sidebar">
        <div class="flex min-h-screen">
          <aside class="hidden w-72 flex-col border-r border-stone-200 bg-[#f7f5f2] lg:flex">
            <div class="flex h-20 items-center justify-between border-b border-stone-200 px-6">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#5c7f74] text-sm font-semibold text-white shadow-sm">S</div>
                <div>
                  <div class="text-lg font-semibold tracking-[0.16em] text-slate-800">SAEROM</div>
                </div>
              </div>
            </div>

            <nav class="flex-1 space-y-2 px-4 py-5">
              <% nav = [{label: 'Dashboard', path: dashboard_path, icon: 'layout-grid'}, {label: 'Patients', path: patients_path, icon: 'users'}, {label: 'Appointments', path: appointments_path, icon: 'calendar-days'}, {label: 'Doctors', path: doctors_path, icon: 'stethoscope'}, {label: 'Medical Records', path: medical_records_path, icon: 'file-medical'}, {label: 'Prescriptions', path: prescriptions_path, icon: 'pill'}, {label: 'Services', path: services_path, icon: 'briefcase-medical'}, {label: 'Billing', path: invoices_path, icon: 'receipt-text'}, {label: 'Staff', path: staffs_path, icon: 'user-round-cog'}, {label: 'Reports', path: reports_path, icon: 'chart-column'}, {label: 'Settings', path: settings_path, icon: 'settings'}] %>
              <% nav.each do |item| %>
                <% active = request.path == item[:path] || (item[:path] == dashboard_path && request.path == '/') %>
                <%= link_to item[:path], class: "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium #{active ? 'bg-[#dfeae6] text-[#194c47]' : 'text-slate-600 hover:bg-stone-200/70 hover:text-slate-800'}" do %>
                  <%= lucide_icon(item[:icon], size: 17) %>
                  <span><%= item[:label] %></span>
                <% end %>
              <% end %>
            </nav>
          </aside>

          <div class="flex flex-1 flex-col">
            <header class="border-b border-stone-200 bg-white/80 backdrop-blur-sm">
              <div class="flex h-20 items-center justify-between px-4 sm:px-6">
                <div class="flex items-center gap-3 lg:hidden">
                  <button type="button" data-action="click->sidebar#toggle" class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-slate-700 hover:bg-stone-100">
                    <%= lucide_icon('menu', size: 18) %>
                  </button>
                  <div class="text-lg font-semibold tracking-[0.16em] text-slate-800">SAEROM</div>
                </div>

                <div class="hidden items-center gap-3 rounded-2xl border border-stone-200 bg-stone-50 px-3 py-2 text-sm text-slate-500 shadow-sm md:flex">
                  <%= lucide_icon('search', size: 16) %>
                  <%= form_with url: search_path, method: :get, class: "flex items-center gap-3" do %>
                    <%= text_field_tag :q, params[:q], placeholder: "Search patients, doctors, records...", class: "w-72 border-0 bg-transparent p-0 text-sm text-slate-700 placeholder:text-slate-400 focus:outline-none", data: { controller: "search" } %>
                  <% end %>
                </div>

                <div class="ml-auto flex items-center gap-3">
                  <div class="hidden items-center gap-2 rounded-full border border-stone-200 bg-stone-50 px-3 py-2 text-xs font-medium text-slate-600 sm:flex">
                    <%= lucide_icon('calendar-days', size: 14) %>
                    <span><%= Date.current.strftime("%a, %b %d") %></span>
                  </div>
                  <button class="inline-flex items-center gap-2 rounded-xl bg-[#5c7f74] px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-[#4d6d67]">
                    <%= lucide_icon('plus', size: 15) %>
                    Quick action
                  </button>
                  <div class="flex items-center gap-3 rounded-xl border border-stone-200 bg-stone-50 px-2 py-1.5">
                    <div class="flex h-9 w-9 items-center justify-center rounded-full bg-[#dfeae6] text-sm font-semibold text-[#194c47]"><%= current_user.name.split.map { |part| part[0] }.first(2).join %></div>
                    <div class="hidden text-left sm:block">
                      <div class="text-sm font-medium text-slate-800"><%= current_user.name %></div>
                      <div class="text-[11px] uppercase tracking-wide text-slate-500"><%= current_user.role.titleize %></div>
                    </div>
                    <%= button_to "Logout", logout_path, method: :delete, class: "text-xs font-medium text-slate-500 hover:text-slate-800" %>
                  </div>
                </div>
              </div>
            </header>

            <main class="flex-1 p-4 sm:p-6 lg:p-8">
              <%= yield %>
            </main>
          </div>
        </div>

        <div data-sidebar-target="mobileMenu" class="fixed inset-0 z-30 hidden bg-slate-900/40 lg:hidden" data-action="click->sidebar#close">
          <div class="h-full w-72 bg-[#f7f5f2] p-4 shadow-xl">
            <div class="mb-4 flex items-center justify-between">
              <div class="text-lg font-semibold tracking-[0.16em] text-slate-800">SAEROM</div>
              <button type="button" data-action="click->sidebar#close" class="rounded-lg p-2 text-slate-600 hover:bg-stone-200">Close</button>
            </div>
            <nav class="space-y-2">
              <% nav.each do |item| %>
                <% active = request.path == item[:path] || (item[:path] == dashboard_path && request.path == '/') %>
                <%= link_to item[:path], class: "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium #{active ? 'bg-[#dfeae6] text-[#194c47]' : 'text-slate-600 hover:bg-stone-200/80'}" do %>
                  <%= lucide_icon(item[:icon], size: 17) %>
                  <span><%= item[:label] %></span>
                <% end %>
              <% end %>
            </nav>
          </div>
        </div>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>
